{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: ParkingManagement.Api [http]",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ParkingManagement.Api/bin/Debug/net9.0/ParkingManagement.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ParkingManagement.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
